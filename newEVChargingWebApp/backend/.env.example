# ======================  Smart EV backend - environment variables  ======================
# Copy to .env for local use. NEVER commit .env or put real secrets in a zip / GitHub.

# ---- Database ----
# Use DB_URL (full JDBC url) OR DB_HOST/DB_PORT/DB_NAME
DB_URL=jdbc:postgresql://localhost:5432/ev_charging_system
DB_USERNAME=postgres
DB_PASSWORD=change_me

# ---- Security ----
# generate with:  openssl rand -base64 48
JWT_SECRET=change_me_to_a_long_random_string_of_at_least_32_chars
JWT_EXPIRATION_MINUTES=720
# frontend origin(s), comma separated. In production use your https domain.
CORS_ALLOWED_ORIGINS=http://localhost:5173
# these e-mails are promoted to ADMIN at startup (register the account first)
ADMIN_EMAILS=you@example.com

# ---- Frontend URL (used inside password-reset e-mails) ----
FRONTEND_URL=http://localhost:5173

# ---- E-mail (optional). Without SPRING_MAIL_HOST e-mails are not sent. ----
# For local testing set MAIL_DEV_LOG=true: reset links are then printed in the backend log.
MAIL_DEV_LOG=true
MAIL_FROM=no-reply@yourdomain.com
# SPRING_MAIL_HOST=smtp.gmail.com
# SPRING_MAIL_PORT=587
# SPRING_MAIL_USERNAME=
# SPRING_MAIL_PASSWORD=

# ---- Razorpay ----
RAZORPAY_KEY_ID=rzp_test_xxxxxxxxxxxx
RAZORPAY_KEY_SECRET=change_me
RAZORPAY_WEBHOOK_SECRET=change_me

# ---- Misc ----
WALLET_DEMO_TOPUP=false
APP_TIMEZONE=Asia/Kolkata
